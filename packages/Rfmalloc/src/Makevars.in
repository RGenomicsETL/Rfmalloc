# Makevars template for fmalloc R package
# This file will be overwritten by the configure script

# Include directories
PKG_CPPFLAGS = -I../inst/fmalloc -DHAVE_CONFIG_H

# Linker flags - include pthread and the fmalloc library  
PKG_LIBS = -L../inst/fmalloc -lfmalloc -lpthread $(BLAS_LIBS) $(FLIBS)

# fmalloc.cpp textually includes every .inc, so a change to one of them has to
# invalidate the object; its own timestamp never moves. The all: target keeps
# the shared library the default goal, as Writing R Extensions requires of any
# Makevars that adds a rule of its own.
all: $(SHLIB)

fmalloc.o: $(wildcard *.inc) fmalloc_internal.h fmalloc_ops.h
